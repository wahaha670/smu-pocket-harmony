{
  "app": {
    "bundleName": "com.smu.pocket",
    "vendor": "smu",
    /*
     * 版本号规则：versionCode = major*1000000 + minor*1000 + patch
     * 例如 1.7.2 -> 1007002
     *
     * ⚠️ 以前这里长期停在 1.1.1（versionCode 1001001），
     *    功能已经迭代到 1.7.x 却一直没跟着改，
     *    装到手机上「关于」显示的还是 1.1.1，与实际不符。
     *    每次发版务必同步更新这两行。
     */
    "versionCode": 1007002,
    "versionName": "1.7.2",
    "icon": "$media:layered_image",
    "label": "$string:app_name"
  }
}
